# 默认按文本处理，入库统一 LF
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.spec text eol=lf
*.iss  text eol=lf

# Windows 脚本需要 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制：模型、图片、图标
*.pt     binary
*.onnx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.bmp    binary
*.ico    binary
*.zip    binary
*.exe    binary
